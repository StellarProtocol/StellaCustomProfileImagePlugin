<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.CustomProfleImage</RootNamespace>
    <AssemblyName>Stellar.CustomProfleImage</AssemblyName>
    <Version>2.1.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- i18n P2: consumes IPluginServices.Localization (framework 2.1.0). -->
    <PackageReference Include="Stellar.Abstractions"       Version="2.1.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.0.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources/customprofleimage-icon.png" LogicalName="Stellar.CustomProfleImage.customprofleimage-icon.png" />
    <EmbeddedResource Include="Lang/en.json" LogicalName="Stellar.CustomProfleImage.Lang.en.json" />
    <EmbeddedResource Include="Lang/ja.json" LogicalName="Stellar.CustomProfleImage.Lang.ja.json" />
    <EmbeddedResource Include="Lang/th.json" LogicalName="Stellar.CustomProfleImage.Lang.th.json" />
    <EmbeddedResource Include="Lang/id.json" LogicalName="Stellar.CustomProfleImage.Lang.id.json" />
    <EmbeddedResource Include="Lang/fil.json" LogicalName="Stellar.CustomProfleImage.Lang.fil.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="resources/**" />
  </ItemGroup>

</Project>
