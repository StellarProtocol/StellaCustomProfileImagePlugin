<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.CustomProfleImage</RootNamespace>
    <AssemblyName>Stellar.CustomProfleImage</AssemblyName>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions"       Version="1.2.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="1.1.1" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources/customprofleimage-icon.png" LogicalName="Stellar.CustomProfleImage.customprofleimage-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="resources/**" />
  </ItemGroup>

</Project>
