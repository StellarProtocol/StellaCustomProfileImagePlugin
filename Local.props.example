<Project>
  <PropertyGroup>
    <!-- Path to your local game_mini folder. Copy this file to Local.props and fill in your path. -->
    <GameInstallDir>C:\path\to\game_mini</GameInstallDir>
  </PropertyGroup>

  <Target Name="DeployPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)plugins\customprofleimage\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameInstallDir)\stellar\plugins\customprofleimage\" />
  </Target>
</Project>
